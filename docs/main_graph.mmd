flowchart TD
    START([START]) --> CFG["load_config<br/>기술·도메인·retry round"]
    CFG --> RUB["load_rubrics<br/>루브릭·규칙"]
    RUB --> RES["tech_research<br/>기술 개요"]

    RES --> PC["plan_collect_work<br/>결정적 WorkPlan"]
    PC -->|"Send × plan.collect_tasks"| EW["Evidence Worker<br/>Evidence + WorkerResult"]
    EW --> EJ(["evidence reducer · join"])

    EJ --> PS["plan_score_work<br/>근거 기반 WorkPlan"]
    PS -->|"Send × plan.score_tasks"| SW["Score Worker<br/>CriterionResult + WorkerResult"]
    SW --> SJ(["score reducer · join"])

    SJ --> BAL{"balance_check<br/>근거·형식·Worker 실패"}
    BAL -->|"research · round < 2"| PC
    BAL -->|"rescore · round < 2"| PS
    BAL -->|"통과 또는 한도 소진<br/>잔여 문제는 info_gaps"| RULE["apply_rules<br/>상한·TRL·상충"]

    RULE --> SYN["synthesize_draft<br/>파일 저장 없음"]
    SYN --> QUAL{"evaluate_report<br/>인용·수치·섹션·표현"}
    QUAL -->|"rewrite<br/>공통 retry < 2"| REWRITE["rewrite_report<br/>품질 오류 피드백"]
    REWRITE --> QUAL
    QUAL -->|"통과"| PREVIEW["render_preview<br/>ReportLab + pypdf"]
    PREVIEW -->|"10페이지 초과<br/>공통 retry < 2"| COMPRESS["compress_report<br/>본문 우선 축약"]
    PREVIEW -->|"10페이지 초과<br/>공통 retry = 2"| FAIL
    COMPRESS --> QUAL
    QUAL -->|"재시도 한도 소진"| FAIL(["END · 품질 실패<br/>최종 PDF 없음"])
    PREVIEW -->|"10페이지 이하"| SAVE["persist_report<br/>MD · PDF · 상세 JSON"]
    SAVE --> END([END])
