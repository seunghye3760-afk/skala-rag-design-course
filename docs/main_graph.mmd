flowchart TD
    START([START]) --> CFG[load_config]
    CFG --> RUB[load_rubrics]
    RUB --> RES[tech_research]
    RES --> PC[plan_collect<br/>TaskPlan 저장]
    PC -->|Send x N| CW[collect_worker]
    CW --> EJ([evidence_join])
    EJ --> PS[plan_score<br/>TaskPlan 저장]
    PS -->|Send x N| SW[score_worker]
    SW --> SJ([score_join])
    SJ --> BAL[balance_check]
    BAL --> SUP{Supervisor}
    SUP -->|근거 부족| PC
    SUP -->|채점 오류| PS
    SUP -->|근거 충분| RULE[apply_rules]
    RULE --> SUP
    SUP -->|초안 작성| SYN[synthesize_report]
    SYN --> SUP
    SUP -->|품질평가| QA[evaluate_report]
    QA --> SUP
    SUP -->|수정| SYN
    SUP -->|통과 또는 한도 소진| FINAL[finalize_report]
    FINAL --> END([END])
